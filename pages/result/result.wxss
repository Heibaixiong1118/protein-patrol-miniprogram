.hero-card {
  text-align: center;
  padding: 56rpx 32rpx;
}

.hero-label {
  font-size: 26rpx;
  color: #888888;
}

.hero-num {
  font-size: 96rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-num.gap {
  color: #07c160;
}

.hero-num.surplus {
  color: #fa9d3b;
}

.hero-unit {
  font-size: 24rpx;
  color: #888888;
}

.verdict {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #576b95;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.macros {
  display: flex;
  text-align: center;
}

.macro {
  flex: 1;
}

.macro-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.macro-num.protein {
  color: #576b95;
}

.macro-label {
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
}

.macro-sub {
  font-size: 20rpx;
  color: #aaaaaa;
  margin-top: 4rpx;
}

.action {
  margin-top: 24rpx;
}

.btn-primary.plain {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.poster-canvas {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 375px;
  height: 640px;
}

.empty {
  text-align: center;
  color: #888888;
  font-size: 26rpx;
  padding: 96rpx 0;
}
